# Render scratch — the CLI's per-run working directory (frame PNGs, transaction dirs).
# The finished MP4 in renders/ is committed; everything else under it is disposable.
renders/work-*/
renders/.*hf-transaction*/

# Regenerated by `node <skill>/scripts/frame-packets.mjs` before a worker dispatch.
.hyperframes/frame-packets/

node_modules/

# Individual snapshot stills are regenerable with `npx hyperframes snapshot`;
# only the contact sheets used for the pre-render review are kept.
snapshots/frame-*.png
